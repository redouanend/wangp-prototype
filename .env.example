# Copie ce fichier en .env et adapte-le (cp .env.example .env).
# Nom unique sur la machine partagée : préfixe avec ton identifiant.
COMPOSE_PROJECT_NAME=wangp-userd
# Port local de l'interface (choisis-en un libre : ss -ltn | grep 7860).
WANGP_PORT=7860
# GPU à utiliser (nvidia-smi -L) : uniquement celui que l'enseignant t'a attribué,
# jamais celui d'Ollama ni celui du stagiaire.
GPU_ID=0
# Dossier des modèles, vidéos et caches. Les modèles pèsent plusieurs dizaines de Go :
# vérifie la place (df -h /var/datalake/home/userD) avant le premier lancement.
DATA_DIR=/var/datalake/home/userD/wangp-data
# Profil mémoire de WanGP. L40S 48 Go : 3 (VRAM large, RAM de la machine partagée),
# ou 1 si la machine a 48 Go de RAM libres ou plus (free -h). 2 entre 12 et 24 Go de VRAM, 4 en dessous.
WANGP_PROFILE=3
# sage (plus rapide, installé par défaut) ou sdpa (si Sage pose problème).
WANGP_ATTENTION=sage
WANGP_EXTRA_ARGS=
# Version de WanGP (commit), figée pour des mesures comparables. 72d5075 = version du 25/11/2026.
WANGP_REF=72d5075
# Ton UID/GID sur la machine (id -u ; id -g), pour que les fichiers de DATA_DIR t'appartiennent.
HOST_UID=1000
HOST_GID=1000
